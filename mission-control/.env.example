# Environment Configuration for Screeps Mission Control

# Screeps Credentials
SCREEPS_EMAIL=your_email@example.com
SCREEPS_PASSWORD=your_password_here
SCREEPS_TOKEN=your_api_token_here

# Or use token authentication (recommended)
# Get token from: https://screeps.com/a/#!/account/auth-tokens
# SCREEPS_TOKEN=your_token_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Screeps Server (default: official server)
SCREEPS_HOST=https://screeps.com
SCREEPS_PORT=443
SCREEPS_SECURE=true

# Primary Room to Monitor
DEFAULT_ROOM=W13N57
DEFAULT_SHARD=shard3

# Update Intervals (milliseconds)
STATUS_UPDATE_INTERVAL=5000
TELEMETRY_UPDATE_INTERVAL=2000
